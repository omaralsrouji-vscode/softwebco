# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Runtime data
*.log
logs/
cache/
tmp/
temp/
sessions/

# User-generated media (curated seed assets remain tracked)
uploads/blogs/blog_*
storage/profile-images/*
!storage/profile-images/default-avatar.png

# Database exports and backups
database/*-database.sql
database/*.dump.sql
database/*.bak
database/*.backup
*.sql.gz
*.zip

# Dependencies generated by package managers
vendor/composer/
node_modules/

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Test and coverage output
.phpunit.cache/
.phpunit.result.cache
coverage/
