# Copy this file to .env for local development. Never commit the real .env.

# Database
SWC_DB_HOST=localhost
SWC_DB_PORT=3306
SWC_DB_NAME=softwebco
SWC_DB_USER=root
SWC_DB_PASSWORD=

# SMTP and contact-form delivery
SWC_SMTP_HOST=smtp.example.com
SWC_SMTP_PORT=587
SWC_SMTP_ENCRYPTION=tls
SWC_SMTP_AUTH=true
SWC_SMTP_USERNAME=
SWC_SMTP_PASSWORD=
SWC_MAIL_FROM_EMAIL=
SWC_MAIL_FROM_NAME="Softwebco Team"
SWC_MAIL_TO_ADDRESSES=
SWC_MAIL_BCC_ADDRESSES=

# Public contact details shown on the website
SWC_PUBLIC_EMAIL=hello@example.com
SWC_PUBLIC_PHONE="+000 00 000 000"
SWC_PUBLIC_PHONE_LINK=+00000000000

# Set to 1 only in a local development environment.
SWC_DEBUG=0
